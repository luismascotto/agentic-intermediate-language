{
  "name": "ail",
  "displayName": "AIL",
  "description": "Agentic Intermediate Language: review a recursive why/what/how spec, and let agents compile it into verified code.",
  "logo": "assets/icon.png",
  "author": {
    "name": "ffMathy"
  },
  "homepage": "https://ffmathy.github.io/agentic-intermediate-language/",
  "repository": "https://github.com/ffMathy/agentic-intermediate-language",
  "keywords": [
    "specification",
    "intermediate-language",
    "codegen",
    "review"
  ],
  "hooks": "./hooks/cursor.json",
  "mcpServers": {
    "ail": {
      "command": "bun",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/src/mcp.ts"
      ],
      "env": {
        "AIL_HOST": "cursor"
      }
    }
  }
}
